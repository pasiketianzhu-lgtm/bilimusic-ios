# .easignore - Overrides .gitignore for EAS builds

# dependencies
node_modules/
.pnpm-store/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native library sources are included, but generated app projects must be
# recreated from app.config.ts for the selected build profile.
/apps/mobile/android/
/apps/mobile/ios/
**/android/build/
**/android/.gradle/
**/android/.cxx/
.kotlin/

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

temp-builds
.yarn/install-state.gz
**/.vscode/
!/.vscode/
!/.vscode/settings.json
!/.vscode/extensions.json
!/.vscode/tasks.json
!/.vscode/launch.json

.zed
.idea
.superpowers/

# Keep local Firebase credentials out of EAS source archives.
**/google-services.real.json
**/GoogleService-Info.real.plist

# Ignore the templates/dummies if necessary, but usually safe to keep
